{
  "hosting": {
    "public": "site/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "build-info.json"],
    "trailingSlash": true,
    "headers": [
      {"source": "**", "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"}
      ]},
      {"source": "/assets/**", "headers": [{"key": "Cache-Control", "value": "public,max-age=3600"}]},
      {"source": "**/*.html", "headers": [{"key": "Cache-Control", "value": "public,max-age=0,must-revalidate"}]}
    ]
  }
}
