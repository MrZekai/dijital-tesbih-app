{
  "expo": {
    "name": "Zikirhane",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.dijitaltesbih.td5pbb",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#06090E"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.dijitaltesbih.td5pbb",
      "permissions": [
        "VIBRATE",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#06090E"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C6A664",
          "defaultChannel": "zikirhane-daily"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
